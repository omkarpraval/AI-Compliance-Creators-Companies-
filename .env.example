# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://verifyd:verifyd@localhost:5432/verifyd
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Security ---
SECRET_KEY=verifyd-dev-secret-key-change-in-production-2026-very-secure
FERNET_KEY=z06nK9H_jG4yX9-J0s7b1Y5qN7P1l6G4yX9-J0s7b1Y=

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=verifyd-media

# --- Hosted AI APIs ---
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
BHASHINI_API_KEY=your-bhashini-api-key-here
BHASHINI_USER_ID=your-bhashini-user-id-here
